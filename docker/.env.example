# 复制为 .env 后修改：docker compose 会自动读取
# MySQL / Redis 在宿主机或其它机器上，本 compose 不启动数据库容器。
#
# 若希望同事「一条命令带上 MySQL+Redis」，请用全栈方案：
#   .env.all-in-one.example → .env.all-in-one
#   docker compose -f docker-compose.all-in-one.yml --env-file .env.all-in-one up -d --build
#   或 ./deploy-all-in-one.sh
#
# Mac/Windows Docker Desktop：连本机 MySQL 可用 host.docker.internal
# Linux：通常填宿主机局域网 IP，或在 compose 里已配 extra_hosts: host.docker.internal

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请修改
MYSQL_DATABASE=hxl_rent

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
# 无密码则留空
REDIS_PASSWORD=

# 对外端口（本机）
API_PORT=26080
H5_PORT=8080
ADMIN_PORT=8081

# 镜像 tag（推送镜像时用）
IMAGE_TAG=latest

# 服务器拉镜像用（push-images.sh / docker-compose.server.yml），本机 build 可不填
# REGISTRY=registry.cn-hangzhou.aliyuncs.com/你的命名空间
REGISTRY=
